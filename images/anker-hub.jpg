<span id="complements-data" data-weblab="DSCX_DESKTOP_POSTPURCHASE_COMPLEMENTS_1400598" data-treatment="T2" data-pill-text="" data-mys-endpoint="https://api-amazondevices.amazon.com/gateway/widget/mars-surveyor-service/graphql" data-csrf-token="hLxvvvHsorPffVRxWodhe/B8bQXruZFEPfbyCgOVJl9rAAAAAGqg6ggAAAAB" style="display:none"></span>

<script type="text/javascript">
    P.when('CCWPoiCheck', 'CCWHydration').execute(function(poiCheck, hydration) {
        var TREATMENT_T1 = 'T1';
        var TREATMENT_T2 = 'T2';
        var ATF_SLOT_ID = 'amazon-device-complements-personalization_feature_div';
        var BTF_SLOT_ID = 'amazon-device-complements-personalization-lower_feature_div';

        var dataEl = document.getElementById('complements-data');
        if (!dataEl) return;
        var weblab = dataEl.getAttribute('data-weblab');
        var treatment = dataEl.getAttribute('data-treatment');
        var pillText = dataEl.getAttribute('data-pill-text');
        // Absent for signed-out customers (controller omits them) â the
        // trigger is then skipped entirely; reveal logic is unaffected.
        var mysEndpoint = dataEl.getAttribute('data-mys-endpoint');
        var csrfToken = dataEl.getAttribute('data-csrf-token');
        if (!weblab || !treatment) return;

        function getRevealedSlotId() {
            if (treatment === TREATMENT_T1) return BTF_SLOT_ID;
            if (treatment === TREATMENT_T2) return ATF_SLOT_ID;
            return null;
        }

        function revealSlot(slotId) {
            var slot = document.getElementById(slotId);
            if (!slot) {
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', function() {
                        revealSlot(slotId);
                    });
                }
                return;
            }
            slot.style.display = '';
            hydrateIfNeeded(slot);
            startReconciler();
        }

        // Hydrate the carousel currently inside the slot, if it needs it.
        // The guard is a property on the node keyed to that node's own
        // data-url, which makes every case behave correctly when Twister
        // swaps ASINs:
        //   - replacement node (no property yet)   -> hydrate
        //   - same node, data-url changed          -> hydrate
        //   - same node, same url, already done    -> skip
        //   - same node, same url, request in air  -> skip (no duplicate AJAX)
        function hydrateIfNeeded(slot) {
            var carousel = slot.querySelector('#ucw-widget-complements-carousel');
            if (!carousel) return;
            var url = carousel.getAttribute('data-url');
            if (!url || carousel.__ccwHydratedUrl === url) return;
            carousel.__ccwHydratedUrl = url;
            // Server renders the container hidden; only unhide when we are
            // about to fill it, so we never fight hydrate()'s own no-recs
            // hiding and re-open an empty min-height gap.
            var skeletonContainer = carousel.closest('#ccw-skeleton-container');
            if (skeletonContainer && skeletonContainer.style.display === 'none') {
                skeletonContainer.style.display = '';
            }
            hydration.hydrate(carousel);
        }

        // Sole owner of post-reveal DOM state. Resolves everything by ID on
        // every tick and holds no node references, so Twister replacing the
        // slot subtree -- or the slot element itself -- cannot orphan it.
        function reconcile() {
            var slotId = getRevealedSlotId();
            if (!slotId) return;
            var slot = document.getElementById(slotId);
            if (!slot) return;

            if (!poiCheck.check()) {
                slot.style.display = 'none';
                updatePill();
                return;
            }
            if (slot.style.display === 'none') slot.style.display = '';
            hydrateIfNeeded(slot);
            updatePill();
        }

        function startReconciler() {
            if (window.__ccwReconcilerStarted) return;
            window.__ccwReconcilerStarted = true;
            setInterval(reconcile, 500);
        }

        function applyTreatment() {
            var slotId = getRevealedSlotId();
            if (slotId) {
                revealSlot(slotId);
            }
            // Control: no slot revealed, nothing further to do.
        }

        // --- Weblab trigger: MYS GraphQL, replacing the deprecated ue.trigger
        // beacon (Forester silently drops non-allowlisted weblabs; these were
        // never allowlisted). The mutation records the trigger SERVER-SIDE
        // against Weblab with a confirmed response. Same session key as the
        // server-side no-trigger getTreatment(), so the returned treatment is
        // the already-assigned one â no re-randomization.
        //
        // Gate = POI presence AND carousel-slot presence. Both are
        // arm-independent (the POI banner and the Symphony-resolved slot
        // divs render identically in all arms), keeping the trigger
        // symmetric across C/T1/T2. The slot check scopes triggers to pages
        // where a carousel could actually render, excluding the
        // accessory/bundle template pages where POI passes but no device
        // program ever resolves.
        var MAX_TRIGGER_ATTEMPTS = 3;
        var RETRY_DELAY_MS = 2000;

        function slotPresent() {
            return !!(document.getElementById(ATF_SLOT_ID) || document.getElementById(BTF_SLOT_ID));
        }

        function isQualified() {
            return poiCheck.check() && slotPresent();
        }

        function triggerWeblab() {
            var controller = typeof window.AbortController !== 'undefined' ?
                new window.AbortController() : null;
            var timeoutId = controller ? setTimeout(function() {
                controller.abort();
            }, 10000) : null;

            function clearTimer() {
                if (timeoutId) { clearTimeout(timeoutId); }
            }

            var options = {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'anti-csrftoken-a2z': csrfToken
                },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'WeblabTreatmentAndTrigger',
                    variables: { id: weblab },
                    query: 'mutation WeblabTreatmentAndTrigger($id: String!) { weblabTreatmentAndTrigger(id: $id) { id treatment } }'
                })
            };
            if (controller) { options.signal = controller.signal; }

            fetch(mysEndpoint, options).then(function(response) {
                if (!response.ok) { throw new Error('HTTP ' + response.status); }
                return response.json();
            }).then(function(data) {
                if (data && data.errors && data.errors.length > 0) {
                    throw new Error('GraphQL: ' + (data.errors[0].message || 'unknown GraphQL error'));
                }
                clearTimer();
                if (window.ue) { ue.count('ccwWeblabTriggerSucceeded', 1); }
            }).catch(function(e) {
                clearTimer();
                // The trigger did not reach the server; reset the guard so a
                // bounded retry can recover the exposure rather than silently
                // losing it. The retry is scheduled here (not via the
                // reconciler, which never runs for Control) so retry behavior
                // stays identical across all arms.
                window.__compZoneTriggerFired = false;
                var reason = (e && e.name === 'AbortError') ? 'timeout' : (e && e.message || 'network error');
                if (window.ue) {
                    ue.count('ccwWeblabTriggerFailed', 1);
                    ue.log('ccwWeblabTriggerFailed', reason);
                }
                if ((window.__ccwTriggerAttempts || 0) < MAX_TRIGGER_ATTEMPTS) {
                    setTimeout(attemptTrigger, RETRY_DELAY_MS * (window.__ccwTriggerAttempts || 1));
                }
            });
        }

        function attemptTrigger() {
            if (window.__compZoneTriggerFired) return;
            // Signed-out (no plumbing emitted) or no fetch support: skip.
            // Browser capability and sign-in state are arm-independent.
            if (!mysEndpoint || !csrfToken || typeof window.fetch !== 'function') return;
            var attempts = window.__ccwTriggerAttempts || 0;
            if (attempts >= MAX_TRIGGER_ATTEMPTS) return;
            window.__compZoneTriggerFired = true;
            window.__ccwTriggerAttempts = attempts + 1;
            triggerWeblab();
        }

        function fireTriggerOnce() {
            attemptTrigger();
            applyTreatment();
        }

        function onQualified() {
            fireTriggerOnce();
        }

        if (isQualified()) {
            onQualified();
        } else {
            var poiInterval = setInterval(function() {
                if (isQualified()) {
                    clearInterval(poiInterval);
                    onQualified();
                }
            }, poiCheck.INTERVAL_MS);
            setTimeout(function() { clearInterval(poiInterval); }, poiCheck.TIMEOUT_MS);
        }

        // Header pill â only rendered for T1/T2 (Control gets empty pillText
        // from the message bundle lookup path; guard anyway since Java always
        // resolves it today).
        if (!pillText) return;

        function createPill() {
            var pill = document.createElement('a');
            pill.className = 'complements-header-pill';
            pill.textContent = pillText;
            pill.addEventListener('click', function(e) {
                var isMobileSurface = !!document.getElementById('mobile_orderInformationGroup_feature_div');
                // CSM engagement counter (aggregate-only; no customer key).
                // Counted for every pill click, including the no-op case where
                // the carousel slot is not resolvable, so the numerator always
                // reflects intent. The typeof check matters here: this runs in a
                // click handler ABOVE preventDefault/scrollTo, so unlike the
                // fetch-chain counters (whose throws land in .catch()), a broken
                // ue.count would otherwise turn the pill click into a dead click.
                if (window.ue && typeof ue.count === 'function') { ue.count(isMobileSurface ? 'ccwPillClickMobile' : 'ccwPillClickDesktop', 1); }
                var slotId = getRevealedSlotId();
                var target = slotId && document.getElementById(slotId);
                if (target) {
                    e.preventDefault();
                    var offset = isMobileSurface ? 60 : 120;
                    window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - offset, behavior: 'smooth' });
                }
            });
            return pill;
        }

        function injectDesktop() {
            var poi = document.getElementById('orderInformationGroup');
            if (!poi) return false;
            var alertContent = poi.querySelector('.a-alert-content');
            if (!alertContent) return false;

            var leftDiv = document.createElement('div');
            while (alertContent.firstChild) {
                leftDiv.appendChild(alertContent.firstChild);
            }

            var rightDiv = document.createElement('div');
            rightDiv.style.cssText = 'display:flex;align-items:center;gap:8px;white-space:nowrap;';
            rightDiv.appendChild(createPill());

            var reviewLink = leftDiv.querySelector('a[href*="review"]');
            if (reviewLink) {
                rightDiv.appendChild(reviewLink);
            }

            alertContent.style.cssText = 'display:flex;justify-content:space-between;align-items:center;';
            alertContent.appendChild(leftDiv);
            alertContent.appendChild(rightDiv);
            // Rendered = counted once per pageview, NOT once per injection: the
            // reconciler re-injects whenever the pill node goes missing while the
            // slot is visible (up to 2/sec), which would silently inflate the CTR
            // denominator. Clicks are human-bounded; renders are not.
            if (window.ue && typeof ue.count === 'function' && !window.__ccwPillRenderedCounted) {
                window.__ccwPillRenderedCounted = true;
                ue.count('ccwPillRenderedDesktop', 1);
            }
            return true;
        }

        function injectMobile() {
            var poi = document.getElementById('mobile_orderInformationGroup_feature_div');
            if (!poi) return false;
            var target = poi.querySelector('.iou-card-main__left')
                      || poi.querySelector('.iou-caption')
                      || poi.querySelector('.iou-card-deck .iou-card')
                      || poi.querySelector('.iou-card');
            if (!target) return false;
            var wrapper = document.createElement('div');
            wrapper.style.padding = '8px 0 4px 0';
            wrapper.appendChild(createPill());
            target.appendChild(wrapper);
            if (window.ue && typeof ue.count === 'function' && !window.__ccwPillRenderedCounted) {
                window.__ccwPillRenderedCounted = true;
                ue.count('ccwPillRenderedMobile', 1);
            }
            return true;
        }

        function isRevealedSlotVisible() {
            var slotId = getRevealedSlotId();
            var el = slotId && document.getElementById(slotId);
            if (!el || el.style.display === 'none') return false;
            var carousel = el.querySelector('#ucw-widget-complements-carousel');
            return !!(carousel && carousel.style.display !== 'none');
        }

        function injectPill() {
            if (window.__complementsHeaderInitDone) return;
            window.__complementsHeaderInitDone = true;
            injectMobile() || injectDesktop();
        }

        // Driven by reconcile(); deliberately owns no timer of its own so
        // that re-running this script on a Twister switch cannot stack
        // duplicate polls (the previous setInterval here leaked one per run).
        function updatePill() {
            if (treatment !== TREATMENT_T1 || !pillText) return;
            var visible = isRevealedSlotVisible();
            var pill = document.querySelector('.complements-header-pill');
            if (pill && !visible) {
                pill.style.display = 'none';
            } else if (pill && visible && pill.style.display === 'none') {
                pill.style.display = '';
            } else if (!pill && visible) {
                window.__complementsHeaderInitDone = false;
                injectPill();
            }
        }

        function initPill() {
            if (treatment !== TREATMENT_T1) return;
            if (isRevealedSlotVisible()) {
                injectPill();
                return;
            }
            window.addEventListener('load', function() {
                if (isRevealedSlotVisible()) {
                    injectPill();
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPill);
        } else {
            initPill();
        }
        window.__complementsHeaderInit = initPill;
    });
</script>

        
    
        
            
