                            </td>
                        
                    
                
                    
                        
                        
                        
                            <td>
                                <p>Wi-Fi 6E tri-band: 802.11 a/b/g/n/ac/ax (2.4GHz, 5GHz, and 6GHz)</p>

                            </td>
                        
                    
                
            </tr>
        
            <tr>
                
                    
                        
                        
                        
