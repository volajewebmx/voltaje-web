dia-popover-media-list-overlay_2x3M5" data-mix-operations="ReviewMediaPopoverNextMediaClickHandler"><div class="_Y3Itd_media-popover-image-view-container_3FDDs" data-physicalid="71HjqX2PijL" data-lazyimagesource="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/I/71HjqX2PijL.jpg"><img alt="G502 X Plus -- A Worthy successor to earlier G502&#39;s for FPS games" src="./logitech-g502_files/transparent-pixel._V192234675_.gif" class="_Y3Itd_media-popover-image-view_3Eum-"></div><div class="_Y3Itd_media-popover-image-view-container_3FDDs" data-physicalid="71peOfBNjiL" data-lazyimagesource="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/I/71peOfBNjiL.jpg"><img alt="G502 X Plus -- A Worthy successor to earlier G502&#39;s for FPS games" src="./logitech-g502_files/transparent-pixel._V192234675_.gif" class="_Y3Itd_media-popover-image-view_3Eum-"></div><div class="_Y3Itd_media-popover-image-view-container_3FDDs" data-physicalid="71qFbW-CP0L" data-lazyimagesource="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/I/71qFbW-CP0L.jpg"><img alt="G502 X Plus -- A Worthy successor to earlier G502&#39;s for FPS games" src="./logitech-g502_files/transparent-pixel._V192234675_.gif" class="_Y3Itd_media-popover-image-view_3Eum-"></div><div class="_Y3Itd_media-popover-image-view-container_3FDDs" data-physicalid="71muGHYiLGL" data-lazyimagesource="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/I/71muGHYiLGL.jpg"><img alt="G502 X Plus -- A Worthy successor to earlier G502&#39;s for FPS games" src="./logitech-g502_files/transparent-pixel._V192234675_.gif" class="_Y3Itd_media-popover-image-view_3Eum-"></div></button></div></div></div></div></div></div></div></div></span></li><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R3EJFDBV2ZC5VL" data-asin="B092CB69Q4" data-mobile="false" data-locale="en-US" data-localelanguagename="English" data-sourcelanguage="en-US" data-sourcelanguagename="English" data-iscustomerrecognized="true" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="ATVPDKIKX0DER"><div id="R3EJFDBV2ZC5VL" data-csa-c-slot-id="customer_review-R3EJFDBV2ZC5VL" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="gzzfd2-55a7ys-u25dyg-nx3z51"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="https://www.amazon.com/gp/profile/amzn1.account.AECE23VUDYK3X4XPNUW3P2TLR4YQ?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R3EJFDBV2ZC5VL_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="k79aq9-k26gh-dbm6a-xlm2ge"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="./logitech-g502_files/grey-pixel.gif" class="a-lazy-loaded" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Garrett</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 out of 5 stars</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="https://www.amazon.com/portal/customer-reviews/srp/-/R3EJFDBV2ZC5VL/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="en-US">Exactly what you would expect from a direct upgrade.</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Reviewed in the United States on April 3, 2026</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="https://www.amazon.com/portal/customer-reviews/B092CB69Q4/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Color: Black<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Style: Wireless<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Pattern Name: RGB<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Configuration: Mouse</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="https://www.amazon.com/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verified Purchase</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-3"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-3-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-3-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-3-card0" data-csa-c-id="x9b0ao-y17yt5-vat25e-this7j"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300" style="max-height:300px"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="en-US" class="_Y3Itd_contain-rich-content_2IORW"><p><span>TBH if your looking for a G502/HERO/Lightspeed replacement there is no complaints in my opinion.</span></p><p><span>Its just a hair bit wider then the previous 502s almost unnoticeable but if you hold them together there is a slight difference.</span></p><p><span>The battery life for it so far has been good for me only been  having to charge it like once a week it feels like.</span></p><p><span>It feels like a upgraded 502 lightspeed which is what is.</span></p><p><span>I like that they gave us a option to replace the thumb button with a flat cover that matches the mouse curve so you dont have to have the thumb button for those of us like myself who accidentally press it and never actually use it.</span></p><p><span>Compared to what we paid at launch for the g502 it feels comparable for value and performance.</span></p><p><span>The scroll wheel feels like a nice upgrade from the deep groves to more of a slightly grooved surface thats easy to catch with your finger without issues.</span></p><p><span>The only thing could probably complain about is lack of weights for those who like the weighted options is not super light but its definitely not as heavy as the previous models so people who like the weight of the 502 hero or lightspeed with weights it is gonna be lighter.</span></p><p><span>I like how they changed the charging cable over to the C type charger just like the G733 headphones it still slides it like before but its alot easier to slide in and out and the cable has a good hold when plug in without that feeling like you might rip it if you pull to hard.</span></p><p><span>Other than that software wise minus the RBG change on the body of the mouse it does everything the same as the HERO and Lightspeed models so its pretty much a direct upgrade and replace without having to relearn or figure new stuff out.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="f8mjws-yvzx0z-92154v-bvxb56"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text" style="">Read more</span><span class="a-see-less-text" style="display:none">Read less</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2" style="display: none !important;"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">One person found this helpful</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B092CB69Q4" data-id="R3EJFDBV2ZC5VL" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R3EJFDBV2ZC5VL_helpful_button" data-csa-c-id="5o9qg3-bu50uo-hpasoc-e51oob"><span class="a-button a-button-base" id="a-autoid-41"