"aok-hidden"><div class="a-section _Y3Itd_media-popover-container_2Vf8U"><div class="_Y3Itd_media-popover-list-container_38-H0"><div class="_Y3Itd_media-popover-container-overlay_1nuZ1" data-hook="ReviewMediaPopover" id="review-media-popover-content-R3EJFDBV2ZC5VL"><div class="_Y3Itd_media-popover-content-wrapper_3MziH"><div class="_Y3Itd_media-popover-background-wrapper_2UMSb"><div class="_Y3Itd_page-indicator-container_1X84N"><div class="_Y3Itd_media-popover-page-indicator_10KaA" data-hook="PageIndicator"></div></div><div class="_Y3Itd_media-popover-topbar_knKqX"><button data-popover-id="R3EJFDBV2ZC5VL" class="_Y3Itd_close-button_2RG2d" data-hook="ReviewMediaPopoverCloseButton" data-mix-operations="ReviewMediaPopoverCloseButtonClickHandler" data-csa-c-type="element" data-csa-c-id="w9fd7r-vpaps6-u2juw3-a762ve"><i class="a-icon a-icon-close-white a-icon-medium" role="presentation"></i></button></div><div class="_Y3Itd_media-popover-media-list-view-container_1kFg1" data-hook="ReviewMediaList"><button data-popover-id="R3EJFDBV2ZC5VL" class="_Y3Itd_media-popover-media-list-overlay_2x3M5" data-mix-operations="ReviewMediaPopoverNextMediaClickHandler"></button></div></div></div></div></div></div></div></div></span></li><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R20J4HHS7NTR3T" data-asin="B092CB69Q4" data-mobile="false" data-locale="en-US" data-localelanguagename="English" data-sourcelanguage="en-US" data-sourcelanguagename="English" data-iscustomerrecognized="true" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="ATVPDKIKX0DER"><div id="R20J4HHS7NTR3T" data-csa-c-slot-id="customer_review-R20J4HHS7NTR3T" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="8uyjcm-f3wncs-c7bq15-6gp5tb"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="https://www.amazon.com/gp/profile/amzn1.account.AGFAYNKQOVXTXTYG3Z4UXB7AG52A?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R20J4HHS7NTR3T_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="f317ot-2extcy-bkjw1a-v0ll0t"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="./logitech-g502_files/grey-pixel.gif" class="a-lazy-loaded" data-src="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/S/amazon-avatars-global/3128cfde-ffb3-42b1-9f9f-5ba27f4150f0._CR0%2C0%2C500%2C500_SX460_SX48_.jpeg"><noscript><img src="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/S/amazon-avatars-global/3128cfde-ffb3-42b1-9f9f-5ba27f4150f0._CR0%2C0%2C500%2C500_SX460_SX48_.jpeg"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Chaz A</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 out of 5 stars</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="https://www.amazon.com/portal/customer-reviews/srp/-/R20J4HHS7NTR3T/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="en-US">Great gaming mouse</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Reviewed in the United States on August 5, 2026</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="https://www.amazon.com/portal/customer-reviews/B092CB69Q4/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Color: Black<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Style: Wireless<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Pattern Name: RGB<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Configuration: Mouse</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="https://www.amazon.com/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verified Purchase</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-4"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-4-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-4-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="basic" name="a-cardui-deck-autoname-4-card0" data-csa-c-id="dp3il0-c0sqqv-3c1obp-kryzv9"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition" style="height: 290px;"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300" style="max-height:300px"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="en-US" class="_Y3Itd_contain-rich-content_2IORW"><p><span>I've been using the Logitech G502 X Plus for about a week now, and it's been excellent so far. I came from an older gaming mouse, and the difference was noticeable right away. Everything feels incredibly smooth and responsive, whether I'm gaming or just using my computer for everyday tasks.</span></p><p><span></span></p><p><span>Setup couldn't have been easier. I plugged in the wireless receiver, turned the mouse on, and it worked immediately. It was truly plug and play. Installing Logitech G HUB was simple too, and customizing the buttons and RGB lighting only took a few minutes.</span></p><p><span></span></p><p><span>The mouse feels very well built and comfortable to use, even during longer gaming sessions. The clicks are crisp, the scroll wheel feels solid, and the sensor tracks flawlessly. I also really like having the extra programmable buttons. They've already become useful for both gaming and general productivity.</span></p><p><span></span></p><p><span>While I can't speak to the long term durability yet, my first impression has been extremely positive. I honestly don't have any complaints so far. If it continues performing this well over time, it'll easily be one of the best gaming mice I've owned. If you're looking for a high quality wireless gaming mouse that's easy to set up and performs exactly as you'd expect, I'd definitely recommend giving this one a look.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha a-hidden"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="pnqood-fpjfen-ad7xjx-ggbjz6"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text" style="">Read more</span><span class="a-see-less-text" style="display:none">Read less</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2" style="display: none !important;"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">One person found this helpful</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B092CB69Q4" data-id="R20J4HHS7NTR3T" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R20J4HHS7NTR3T_helpful_button" data-csa-c-id="6485b1-enriir-d1tnbt-nwnc2q"><span class="a-button a-button-base" id="a-autoid-44"><span class="a-button-inner"><input type="submit" class="a-button-input" aria-labelledby="a-autoid-44-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-44-announce"><div class="_Y3Itd_cr-helpful-text-desktop_2dXQG">Helpful</div></span></span></span></div><span data-hook="helpfulVoteLoadingMessage" class="_Y3Itd_hidden_1J5OD">Sending feedback...</span><div data-hook="helpfulVoteSuccessMessage" class="a-box a-alert-inline a-alert-inline-success _Y3Itd_hidden_1J5OD a-spacing-block" aria-live="polite" aria-atomic="true"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">Thank you for your feedback.</div></div></div><div data-hook="helpfulVoteErrorMessage" class="a-box a-alert-inline a-alert-inline-error _Y3Itd_hidden_1