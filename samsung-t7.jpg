    <div class="a-section a-spacing-small a-spacing-top-small">  <table class="a-normal a-spacing-micro" role="list">  <tbody><tr class="a-spacing-small po-digital_storage_capacity" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Digital Storage Capacity</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">1 TB</span>   </td> </tr>  <tr class="a-spacing-small po-hard_disk.interface" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Hard Disk Interface</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">USB 3.2</span>   </td> </tr>  <tr class="a-spacing-small po-connectivity_technology" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Connectivity Technology</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">USB 3.2 Gen 2</span>   </td> </tr>  <tr class="a-spacing-small po-brand" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Brand</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">Samsung</span>   </td> </tr>  <tr class="a-spacing-small po-special_feature" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Special Feature</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">Hardware Encryption, Portable</span>   </td> </tr>  <tr class="a-spacing-small po-hard_disk_form_factor" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Hard Disk Form Factor</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">2.5 inches</span>   </td> </tr>  <tr class="a-spacing-small po-hard_disk.description" role="l