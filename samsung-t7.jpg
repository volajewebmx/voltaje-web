ner_1kFg1" data-hook="ReviewMediaList"><button data-popover-id="R3BBVCRL3A174H" class="_Y3Itd_media-popover-media-list-overlay_2x3M5" data-mix-operations="ReviewMediaPopoverNextMediaClickHandler"></button></div></div></div></div></div></div></div></div></span></li><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R2O39AXVILH4ZT" data-asin="B09VLHR4JC" data-mobile="false" data-locale="en-US" data-localelanguagename="English" data-sourcelanguage="en-US" data-sourcelanguagename="English" data-iscustomerrecognized="true" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="ATVPDKIKX0DER"><div id="R2O39AXVILH4ZT" data-csa-c-slot-id="customer_review-R2O39AXVILH4ZT" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="zi5eiz-tt044y-sov711-9jgtej"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="https://www.amazon.com/gp/profile/amzn1.account.AHWAJQNG6HVMHOBWGZRQ7R47GW4Q?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R2O39AXVILH4ZT_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="4k633b-10bqm-ptofgh-9os8tu"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="./samsung-t7_files/grey-pixel.gif" class="a-lazy-loaded" data-src="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/S/amazon-avatars-global/40b70ea5-e32e-479b-a891-a956d94ec43c._CR62%2C0%2C375%2C375_SX460_SX48_.jpg"><noscript><img src="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/S/amazon-avatars-global/40b70ea5-e32e-479b-a891-a956d94ec43c._CR62%2C0%2C375%2C375_SX460_SX48_.jpg"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Smack</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 out of 5 stars</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="https://www.amazon.com/portal/customer-reviews/srp/-/R2O39AXVILH4ZT/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="en-US">Fast and reliable USB drive</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Reviewed in the United States on August 18, 2025</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="https://www.amazon.com/portal/customer-reviews/B09VLHR4JC/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Color: Black<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Capacity: 2 TB</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="https://www.amazon.com/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verified Purchase</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-3"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-3-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-3-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-3-card0" data-csa-c-id="s8m052-7ii1b1-ddomt6-ifj8yc"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300" style="max-height:300px"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="en-US" class="_Y3Itd_contain-rich-content_2IORW"><p><span>Fast and reliable USB drive. I will only purchase SSD drives now rather than a traditional spinning platter drive. As a video editor, the drive capacity and read speed is critical. I have a few of these now in different size capacities and these Samsung T7 drives are my preferred external drives for a few reasons.</span></p><p><span>First, they're SSD drives so the possibility to go bad in contrast to a spinning platter drive is very slim. I have lost a few traditional drives over the years and once is enough. I have not had an SSD drive fail yet.</span></p><p><span>Second, these Samsungs are fast. I am able to edit high bit rate, 4k media directly from these USB-C drives without having to bog down my internal drives with the footage files. The read speed is quick enough to not be a concern while editing directly from the drives. I've not been concerned with write speed but the benchmark tests are still high. They do not get hot like the traditional drives do.</span></p><p><span>Form factor: tiny and easy to transport! I have 1TB, 2 TB, and 4 TB drives. Three of these together are still smaller than a traditional rugged external drive AND with no moving parts, I don't need to be concerned with careful packing and accidental shock.</span></p><p><span>They arrive formatted as exfat so very easy to use with either mac or PC. They're affordable too. Every time a cheap client or agency provides me footage on a slow, sub-standard platter drive, I transfer it all to one of these Samsungs asap.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="fj4mxn-ygjbzg-lxerei-rfbhe5"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text" style="">Read more</span><span class="a-see-less-text" style="display:none">Read less</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2" style="display: none !important;"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-small"><div class="a-section a-spacing-none _Y3Itd_single-review-image-tile-section_15c2C"><button class="_Y3Itd_single-review-thumbnail-container_9KgXc" data-mix-operations="SingleReviewMediaImageThumbnailClickHandler" data-reviewid="R2O39AXVILH4ZT" data-physicalid="61YcXYNBd+L"><img alt="Fast and reliable USB drive" src="./samsung-t7_files/61YcXYNBd+L._SY500_.jpg" data-hook="review-image-tile" class="_Y3Itd_single-review-image-tile_3c5HW"></button><div id="mediaModal_R2O39AXVILH4ZT"><div class="a-popover-preload" id="a-popover-cr-top-reviews-media-modal_R2O39AXVILH4ZT"><div class="_Y3Itd_media-popover-header-container_1kb6I"></div><div class="_Y3Itd_single-review-media-popover-container_FDNFG" data-hook="media-popover-container"><div class="_Y3Itd_modal-content-container_1p_Aj" data-csa-c-type="widget" data-reviewbind="SingleReviewMediaBlock" data-reviewid="R2O39AXVILH4ZT" data-csa-c-slot-id="cm_cr_image_popover" data-closebuttonaria="" data-modaltitlearia="" data-hook="modal-content-container" data-csa-c-id="5pv5sz-c67j1r-dtt2vc-kvwp4o"><div class="_Y3Itd_media-popover-body-container_3kalb"><div class="_Y3Itd_media-popover-media-container_39x8v"><button class="_Y3Itd_left-icon-container_1saao" data-mix-operations="leftClickHandler"><span class="_Y3Itd_cr-icon_S_3MZ"><img role="img" aria-label="" class="_Y3Itd_button-icon_1Xsqv" src="./samsung-t7_files/23pID5Mp1WTA-31.svg"></span></button><div data-reviewbind="MainMedia" class="_Y3Itd_media-popover-modal-media-list-view-container_1uARM"><div class="_Y3Itd_media-popover-image-view-container_1XEVZ" data-mediaid="61YcXYNBd+L" data-lazyimagesource="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/I/61YcXYNBd+L.jpg" data-csa-c-type="element" data-csa-c-slot-id="cm_cr_image_popover_61YcXYNBd+L_0" data-csa-c-id="zd7k2s-782adq-ognh76-6hjyah"><img alt="Fast and reliable USB drive" src="./samsung-t7_files/61YcXYNBd+L._SY500_.jpg" class="_Y3Itd_media-popover-image-view_1J8fN"></div></div><button class="_Y3Itd_right-icon-container_2ryP4" data-mix-operations="rightClickHandler"><span class="_Y3Itd_cr-icon_S_3MZ"><img role="img" aria-label="" class="_Y3Itd_button-icon_1Xsqv" src="./samsung-t7_files/7D8iRtQ0DrKAF4O.svg"></span></button></div><div class="_Y3Itd_media-popover-review-container_1w2Ex"><div class="a-section _Y3Itd_cr-media-popover-sidepanel-container_2rHXZ"><div class="a-section a-spacing-small _Y3Itd_cr-media-popover-sidepanel-header-section_KhwYb"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="https://www.amazon.com/gp/profile/amzn1.account.AHWAJQNG6HVMHOBWGZRQ7R47GW4Q" data-csa-c-slot-id="profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="1ovocj-n047cw-dsp2jp-ojwo98"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="./samsung-t7_files/grey-pixel.gif" class="a-lazy-loaded" data-src="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/S/amazon-avatars-global/40b70ea5-e32e-479b-a891-a956d94ec43c._CR62%2C0%2C375%2C375_SX460_SX48_.jpg" style=""><noscript><img src="https://m.media-amazon.com/images/W/BW_MEDIAX_AVIF_MEASUREMENT_1306696-T2/images/S/amazon-avatars-global/40b70ea5-e32e-479b-a891-a956d94ec43c._CR62%2C0%2C375%2C375_SX460_SX48_.jpg"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Smack</span></div></a></div><div class="a-section a-spacing-none"><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 out of 5 stars</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="https://www.amazon.com/portal/customer-reviews/srp/-/R2O39AXVILH4ZT/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="en-US">Fast and reliable USB drive</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Reviewed in the United States on August 18, 2025</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="https://www.amazon.com/portal/customer-reviews/B09VLHR4JC/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Color: Black<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Capacity: 2 TB</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="https://www.amazon.com/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verified Purchase</span></a></div></span></div></div><p><span>Fast and reliable USB drive. I will only purchase SSD drives now rather than a traditional spinning platter drive. As a video editor, the drive capacity and read speed is critical. I have a few of these now in different size capacities and these Samsung T7 drives are my preferred external drives for a few reasons.</span></p><p><span>First, they're SSD drives so the possibility to go bad in contrast to a spinning platter drive is very slim. I have lost a few traditional drives over the years and once is enough. I have not had an SSD drive fail yet.</span></p><p><span>Second, these Samsungs are fast. I am able to edit high bit rate, 4k media directly from these USB-C drives without having to bog down my internal drives with the footage files. The read speed is quick enough to not be a concern while editing directly from the drives. I've not been concerned with write speed but the benchmark tests are still high. They do not get hot like the traditional drives do.</span></p><p><span>Form factor: tiny and easy to transport! I have 1TB, 2 TB, and 4 TB drives. Three of these together are still smaller than a traditional rugged external drive AND with no moving parts, I don't need to be concerned with careful packing and accidental shock.</span></p><p><span>They arrive formatted as exfat so very easy to use with either mac or PC. They're affordable too. Every time a cheap client or agency provides me footage on a slow, sub-standard platter drive, I transfer it all to one of these Samsungs asap.</span></p><ul class="_Y3Itd_media-popover-thumbnail-image-container_2nWBS" data-reviewbind="MediaThumbnailsBlock"><li class="_Y3Itd_media-popover-list-item-style_d1lj6" data-reviewbind="MediaThumbnail"><button data-mediaid="61YcXYNBd+L" data-reviewid="R2O39AXVILH4ZT" data-thumbidx="0" class="_Y3Itd_media-popover-thumbnail-image-button_2LRc_" data-mix-operations="thumbnailClickHandler" aria-pressed="false"><img alt="" src="./samsung-t7_files/61YcXYNBd+L.jpg" class="_Y3Itd_media-popover-thumbnail-image-view_2J_oP" height="80" width="80"></button></li></ul></div></div></div></div></div></div></div></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">116 people found this helpful</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B09VLHR4JC" data-id="R2O39AXVILH4ZT" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R2O39AXVILH4ZT_helpful_button" data-csa-c-id="ub12fi-e9uk05-lk7bnt-3i0pxk"><span class="a-button a-button-base" id="a-autoid-41"><span class="a-button-inner"><input type="submit" class="a-button-input" aria-labelledby="a-autoid-41-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-41-announce"><div class="_Y3Itd_cr-helpful-text-desktop_2dXQG">Helpful</div></span></span></span></div><span data-hook="helpfulVoteLoadingMessage" class="_Y3Itd_hidden_1J5OD">Sending feedback...</span><div data-hook="helpfulVoteSuccessMessage" class="a-box a-alert-inline a-alert-inline-success _Y3Itd_hidden_1J5OD a-spacing-block" aria-live="polite" aria-atomic="true"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">Thank you for your feedback.</div></div>