/help/customer/display.html?nodeId=GLHXEX85MENUE4XF&amp;ref=cm_cr_cg">community guidelines<span class="aok-offscreen">Opens in a new tab</span></a>. If it doesn't, we'll remove it.</p></div><div class="a-row a-spacing-top-base"><div class="_Y3Itd_reportAbuseConfirmationActions_27dEm"><div data-mix-operations="ReportAbuseCancelClickHandler" data-id="RWCYIR55US66X"><span class="a-button a-button-base" id="a-autoid-51"><span class="a-button-inner"><input type="submit" data-hook="reportAbuseCancelButton" class="a-button-input" aria-labelledby="a-autoid-51-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-51-announce">Cancel</span></span></span></div><div data-mix-operations="ReportAbuseConfirmClickHandler" data-id="RWCYIR55US66X"><span class="a-button a-button-primary" id="a-autoid-52"><span class="a-button-inner"><input type="submit" data-hook="reportAbuseConfirmButton" class="a-button-input" aria-labelledby="a-autoid-52-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-52-announce">Report</span></span></span></div></div></div></div></div></div></div></div></div><div id="cr-review-media-popover-RWCYIR55US66X" class="aok-hidden"><div class="a-section _Y3Itd_media-popover-container_2Vf8U"><div class="_Y3Itd_media-popover-list-container_38-H0"><div class="_Y3Itd_media-popover-container-overlay_1nuZ1" data-hook="ReviewMediaPopover" id="review-media-popover-content-RWCYIR55US66X"><div class="_Y3Itd_media-popover-content-wrapper_3MziH"><div class="_Y3Itd_media-popover-background-wrapper_2UMSb"><div class="_Y3Itd_page-indicator-container_1X84N"><div class="_Y3Itd_media-popover-page-indicator_10KaA" data-hook="PageIndicator"></div></div><div class="_Y3Itd_media-popover-topbar_knKqX"><button data-popover-id="RWCYIR55US66X" class="_Y3Itd_close-button_2RG2d" data-hook="ReviewMediaPopoverCloseButton" data-mix-operations="ReviewMediaPopoverCloseButtonClickHandler" data-csa-c-type="element" data-csa-c-id="lspsh-zbc36n-eyhmxu-oot1r0"><i class="a-icon a-icon-close-white a-icon-medium" role="presentation"></i></button></div><div class="_Y3Itd_media-popover-media-list-view-container_1kFg1" data-hook="ReviewMediaList"><button data-popover-id="RWCYIR55US66X" class="_Y3Itd_media-popover-media-list-overlay_2x3M5" data-mix-operations="ReviewMediaPopoverNextMediaClickHandler"></button></div></div></div></div></div></div></div></div></span></li><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R2X4B98NBN87XT" data-asin="B0BHZQGN26" data-mobile="false" data-locale="en-US" data-localelanguagename="English" data-sourcelanguage="en-US" data-sourcelanguagename="English" data-iscustomerrecognized="true" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="ATVPDKIKX0DER"><div id="R2X4B98NBN87XT" data-csa-c-slot-id="customer_review-R2X4B98NBN87XT" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="nvta3b-378ok1-6tkmq0-wxe92d"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="https://www.amazon.com/gp/profile/amzn1.account.AF75H5TNNA5R3ARP562B7ZE4TG6A?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R2X4B98NBN87XT_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="5rhopc-fqxp5e-5nqxrt-1ke4wf"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="./samsung-t7_files/grey-pixel.gif" class="a-lazy-loaded" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">tlynn</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-4"><span class="a-icon-alt">4 out of 5 stars</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="https://www.amazon.com/portal/customer-reviews/srp/-/R2X4B98NBN87XT/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="en-US">Great ergo design, solid product overall but...</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Reviewed in the United States on August 26, 2026</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="https://www.amazon.com/portal/customer-reviews/B0BHZQGN26/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Color: Black<i class="a-icon a-icon-text-separator" role="presentation"></i></span><span class="a-size-base a-color-secondary">Capacity: 4 TB</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="https://www.amazon.com/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verified Purchase</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-7"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-7-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-7-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-7-card0" data-csa-c-id="mxarm0-8d0e8a-e5pmin-9mii14"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300" style="max-height:300px"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="en-US" class="_Y3Itd_contain-rich-content_2IORW"><p><span>Bought 2 of the 4 TB T7s in Nov 2023.  They are used to keep duplicate offline backups of the data drive of my main computer.  I paid $200 each.  I wanted another one this week and I about fell over seeing a $1100+ price!  Apparently the AI data center buildouts are creating such a demand in memory chips, they are driving the price of these drives through the roof.  Definitely sorry for you if you are looking to purchase now.</span></p><p><span></span></p><p><span>They have been 100% reliable until recently, when I needed to update my backups after maybe 4 months offline.  I mirror the drives using a Robocopy script, and they stay offline to prevent ransomware attacks.  One of the drives would not show up when I plugged it in to my main box (Windows) the other day. Read/write light was constantly flashing a steady pattern.  It was visible when I plugged it into a Linux box but kept telling me something like waiting for device.  Back to the Windows box and still nothing.  Refreshing disk manager did nothing.  So I put it back on the Linux box and was able to format it NTFS.  Back on the Windows box and the drive finally was recognized, thankfully.  I mirrored the drives to get the formatted one back to previous state and then saved off changes from the Windows PC and everything is working fine now.  So this little glitch dropped my trust level in this product which is why 4 stars.  Hoping it holds up longer term.  A problem like this is why I mirror two drives in the first place.  If it was still $200 I might have bought another one and kept three copies just to be overly cautious, but not at today's price point.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="kky3bo-d5svpo-guocil-bthwu2"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text" style="">Read more</span><span class="a-see-less-text" style="display:none">Read less</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2" style="display: none !important;"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">One person found this helpful</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B0BHZQGN26" data-id="R2X4B98NBN87XT" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R2X4B98NBN