            <div class="celwidget ask-product-docs-B09XS7JWHH" cel_widget_id="ask-product-docs-widget" data-csa-c-id="4y7jdk-fm4j8-c6k4h-k2iohy" data-cel-widget="ask-product-docs-widget">
      <div class="a-row a-spacing-medium a-spacing-top-medium"> <div class="a-column a-span6"> <h2 class="a-spacing-medium a-color-base"> Product guides and documents </h2>  <div class="celwidget ask-product-docs-B09XS7JWHH" cel_widget_id="ask-product-docs-link-1" data-csa-c-id="adaqbs-ykhkh-z4om0t-zbucw2" data-cel-widget="ask-product-docs-link-1">
              <a href="https://m.media-amazon.com/images/I/B1+KMPweXgL.pdf" rel="nofollow" target="_blank" onclick="window.open(this.href,&#39;ProductDisplay&#39;,&#39;width=500,height=500,dependent=yes,directories=no,location=no,menubar=no,resizable=yes,scrollbar=yes,toolbar=no&#39;);return false;">User Guide (PDF)</a>
