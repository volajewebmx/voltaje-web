ickHandler" data-id="R296H0MM1B5KU8"><span class="a-button a-button-primary" id="a-autoid-124"><span class="a-button-inner"><input type="submit" data-hook="reportAbuseConfirmButton" class="a-button-input" aria-labelledby="a-autoid-124-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-124-announce">Report</span></span></span></div></div></div></div></div></div></div></div></div><div id="cr-review-media-popover-R296H0MM1B5KU8" class="aok-hidden"><div class="a-section _Y3Itd_media-popover-container_2Vf8U"><div class="_Y3Itd_media-popover-list-container_38-H0"><div class="_Y3Itd_media-popover-container-overlay_1nuZ1" data-hook="ReviewMediaPopover" id="review-media-popover-content-R296H0MM1B5KU8"><div class="_Y3Itd_media-popover-content-wrapper_3MziH"><div class="_Y3Itd_media-popover-background-wrapper_2UMSb"><div class="_Y3Itd_page-indicator-container_1X84N"><div class="_Y3Itd_media-popover-page-indicator_10KaA" data-hook="PageIndicator"></div></div><div class="_Y3Itd_media-popover-topbar_knKqX"><button data-popover-id="R296H0MM1B5KU8" class="_Y3Itd_close-button_2RG2d" data-hook="ReviewMediaPopoverCloseButton" data-mix-operations="ReviewMediaPopoverCloseButtonClickHandler" data-csa-c-type="element" data-csa-c-id="aa0iat-hptog1-f4c322-2k6d02"><i class="a-icon a-icon-close-white a-icon-medium" role="presentation"></i></button></div><div class="_Y3Itd_media-popover-media-list-view-container_1kFg1" data-hook="ReviewMediaList"><button data-popover-id="R296H0MM1B5KU8" class="_Y3Itd_media-popover-media-list-overlay_2x3M5" data-mix-operations="ReviewMediaPopoverNextMediaClickHandler"></button></div></div></div></div></div></div></div></div></span></li><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R10098H37FA770" data-asin="B09XS7JWHH" data-mobile="false" data-locale="en-US" data-localelanguagename="English" data-sourcelanguage="en-US" data-sourcelanguagename="English" data-iscustomerrecognized="true" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="ATVPDKIKX0DER"><div id="R10098H37FA770" data-csa-c-slot-id="customer_review-R10098H37FA770" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="157c7h-mo9jtp-26yzef-o4bifp"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="https://www.amazon.com/gp/profile/amzn1.account.AE56JO2NOAX6EJDYRLHDAUZW5VLQ?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R10098H37FA770_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="ngsu8p-p2e07f-h6al6l-r34hm8"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="./sony-xm5_files/grey-pixel.gif" class="a-lazy-loaded" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/2643fa5a-58ec-4ec4-9e1e-62d4418cfd5a._CR0%2C0%2C768%2C768_SX460_SX48_.jpg"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/2643fa5a-58ec-4ec4-9e1e-62d4418cfd5a._CR0%2C0%2C768%2C768_SX460_SX48_.jpg"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Waydavis</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 out of 5 stars</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="https://www.amazon.com/portal/customer-reviews/srp/-/R10098H37FA770/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="en-US">Are you Older?  READ THIS.</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Reviewed in the United States on May 4, 2023</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="https://www.amazon.com/portal/customer-reviews/B09XS7JWHH/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Color: Black</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="https://www.amazon.com/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verified Purchase</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-18"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-18-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-18-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-18-card0" data-csa-c-id="2o2erw-42c8u-lzpzuf-3kkne6"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300" style="max-height:300px"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="en-US" class="_Y3Itd_contain-rich-content_2IORW"><p><span>I am almost 65 years old SO, I DO NOT have the ears of a 18 year old.  That said, I consider these to be good for these reasons:</span></p><p><span></span></p><p><span>A: Exceptional battery life.</span></p><p><span></span></p><p><span>B: Call quality that was considered good UNTIL I did a direct comparison to my Blueparrott B450-XT’s -  NO WHERE NEAR the quality of the Blue 450’s, BUT the Blues are made specifically for calls in noisey environments. . Blues are in my opionion the defacto standard by which all other ANC phone calls should be judged. My "demo" for people is to run my upright vacuum cleaner whilst on a call.  People on the other end cannot hear it AT ALL – REALLY!, I hear them, and they hear me perfectly! TRULY amazing!  I did the same test with these and alas they failed miserably in comparison.  I expected that. I was told they sound like I am in a room away from the microphone, a bit fishtank like, and muddy. SO, they’ll do in a call but not as a primary phone call device in noise.  I heard a sample of the BOSE 700’s and they were terrible, which is what prompted me to get the Sony’s.</span></p><p><span></span></p><p><span>C:  One unconventional thing they do great at: A Sleep Aid. Yup, they drown out all the extraneous noises like people talking, Air conditioners, fans, Water coolers, hums, etc.  ALL gone with nothing playing through them!</span></p><p><span></span></p><p><span>I bought them primarily for playing on my PS5, and watching TV late at night. They do both quite well.</span></p><p><span></span></p><p><span>D: Amazingly, my ears do not sweat much in these even after prolonged use.  I’ve ordered those Dekoni Suede Earpads for them as well just for added comfort.</span></p><p><span>(https://www.amazon.com/dp/B0BS4T3X62?psc=1&amp;ref=ppx_yo2ov_dt_b_product_details)</span></p><p><span>(5/16/23 - Returned The earpads: they claim they are suede when in fact they are 2/3 suede. The inner part inside the cup is something else, not leather so NOT durable. Considering this, $49 seems FAR too expensive.)</span></p><p><span></span></p><p><span>E:  They are long-term comfortable unless you have ears like a B-52 in which case you will probably be stuffing bits.</span></p><p><span></span></p><p><span>As for music, I find them to be more flat without pronounced highs or bass - which I prefer.  The  EQ on the app is a nice feature. The ANC works very well listening to music and will be adequate to the task in both quiet and noisey settings.  Again, I remind you, I’m not 18. ;-)</span></p><p><span></span></p><p><span>Pricewise, they ARE a bit expensive but the build quality seems better than most.</span></p><p><span></span></p><p><span>If you have the time, I would HIGHLY recommend you test several brands and models at a store simply because sound quality is subjective and EVERYONE has their preference.</span></p><p><span>UPDATE: 5/23/23 - Returning (REPLACING) Headphones - Why?  They started acting "Funky".  By that, I mean that if you turn them off, they will not turn on unless you do not hit any buttons for about 15 sec. NOT normal.  ALSO, they started to exhibit Connection issues that were NOT there initially.  I STILL, at this point consider them excelllent. Now, if the NEW pair goes weird, THEN I would have to re-evaluate.</span></p><p><span>UPDATE 6-3-23:  New pair are working as they should no connection issues or on/off bttun problems.</span></p><p><span>UPDATE 2-16-24: Still working perfectly and I use them nearly every night to sleep.</span></p><p><span>UPDATE 7-31-25: Still working great and I still use them as silencers.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="x6fh0m-6d6xdh-rkj8dm-irhvu1"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text" style="">Read more</span><span class="a-see-less-text" style="display:none">Read less</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2" style="display: none !important;"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">1,826 people found this helpful</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B09XS7JWHH" data-id="R10098H37FA770" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R10098H37FA770_helpful_button" data-csa-c-id="g9hz24-imnu5w-n23qtp-52691s"><span class="a-button a-button-base" id="a-autoid-125"><span class="a-button-inner"><input type="submit" class="a-button-input" aria-labelledby="a-autoid-125-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-125-announce"><div class="_Y3Itd_cr-helpful-text-desktop_2dXQG">Helpful</div></span></span></span></div><span data-hook="helpfulVoteLoadingMessage" class="_Y3Itd_hidden_1J5OD">Sending feedback...</span><div data-hook="helpfulVoteSuccessMessage" class="a-box a-alert-inline a-alert-inline-success _Y3Itd_hidden_1J5OD a-spacing-block" aria-live="polite" aria-atomic="true"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-ale