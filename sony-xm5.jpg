<!--CardsClient--><div id="CardInstancem2c4IHTjbSzkjBu1k-H7WA" data-card-metrics-id="cr-top-reviews_customer-reviews-top-reviews_0" data-acp-tracking="{}" data-mix-claimed="true"><div id="cr-top-reviews-card"></div><span data-metadata-map="{&quot;isDarkTheme&quot;:&quot;false&quot;,&quot;isRobot&quot;:&quot;false&quot;,&quot;personaApiThrottled&quot;:&quot;false&quot;,&quot;asin&quot;:&quot;B09XS7JWHH&quot;,&quot;voteApiThrottled&quot;:&quot;false&quot;,&quot;isAuthenticated&quot;:&quot;false&quot;,&quot;twisterVariationsApiThrottled&quot;:&quot;false&quot;}" data-card-id="CustomerTopReviewsCards" data-request-context="{&quot;csrfT&quot;:&quot;&quot;,&quot;isAndroidApp&quot;:false,&quot;isCustomerRecognized&quot;:true,&quot;isIosApp&quot;:false,&quot;isKindleApp&quot;:false,&quot;isMobile&quot;:false,&quot;isMshop&quot;:false,&quot;locale&quot;:&quot;en-US&quot;,&quot;localeLanguageName&quot;:&quot;English&quot;,&quot;marketplaceId&quot;:&quot;ATVPDKIKX0DER&quot;,&quot;isRobot&quot;:false,&quot;personaApiThrottled&quot;:false,&quot;twisterVariationsApiThrottled&quot;:false,&quot;voteApiThrottled&quot;:false,&quot;sessionId&quot;:&quot;138-2885330-7686019&quot;,&quot;isDarkTheme&quot;:false,&quot;profileRefTag&quot;:&quot;cm_cr_dp_d_bdcrb_top&quot;,&quot;isReportAbuseConfirmationEnabled&quot;:true}" data-notable-quotes-treatment="" class="aok-hidden"></span><div class="aok-hidden" aria-hidden="true"><div id="cr-top-reviews-filter-loading-message">Filtering customer reviews</div><div id="cr-top-reviews-clear-filter-loading-message">Loading customer reviews</div></div><div id="cr-top-reviews-live-region" class="a-offscreen" aria-live="polite"></div><div id="cr-top-reviews"><div class="_Y3Itd_top-reviews-section_1AqcY" id="top-reviews-notifications"><div class="aok-hidden" id="top-reviews-softlines-filter-error"><div class="a-box a-alert a-alert-error a-spacing-extra-large a-spacing-top-medium" role="alert"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">There was a problem filtering reviews. Please reload the page.</div></div></div></div><div id="top-reviews-spinner" class="_Y3Itd_spinner-container_2y2KN aok-hidden"><span class="a-spinner a-spinner-medium"></span></div></div><div class="a-section a-spacing-none a-padding-none"><div id="localTopReviews" class="_Y3Itd_top-reviews-section_1AqcY"><h3 class="a-spacing-medium a-spacing-top-large">Top reviews from the United States</h3><ul id="localTopReviewsList" data-csa-c-slot-id="cm-cr-dp-review-list" data-csa-c-type="widget" class="a-unordered-list a-nostyle a-vertical" data-csa-c-id="o2cxg8-mgiqmx-w6a1mp-v9ggsy"><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R1QX35O9YTHQP2" data-asin="B09XSDMT4F" data-mobile="false" data-locale="en-US" data-localelanguagename="English" data-sourcelanguage="en-US" data-sourcelanguagename="English" data-iscustomerrecognized="true" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="ATVPDKIKX0DER"><div id="R1QX35O9YTHQP2" data-csa-c-slot-id="customer_review-R1QX35O9YTHQP2" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="j1zeyc-8grnft-r1k6ik-3bn7r2"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="https://www.amazon.com/gp/profile/amzn1.account.AHRXR77KGQXCYA4BVHGED4J73QVA?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R1QX35O9YTHQP2_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="a8ukhr-8iun58-spdjaa-4khcet"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="./sony-xm5_files/grey-pixel.gif" class="a-lazy-loaded" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">shingold</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 out of 5 stars</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="https://www.amazon.com/portal/customer-reviews/srp/-/R1QX35O9YTHQP2/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="en-US">Good ANC, long lasting, durable.</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Reviewed in the United States on September 1, 2026</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="https://www.amazon.com/portal/customer-reviews/B09XSDMT4F/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Color: Silver</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="https://www.amazon.com/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verified Purchase</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-16"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-16-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-16-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-16-card0" data-csa-c-id="6lvgwq-yo2u6l-ezw42e-vk0erk"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300" style="max-height:300px"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="en-US" class="_Y3Itd_contain-rich-content_2IORW"><p><span>I bought these in January of 2023. I figure a review might be good to share.</span></p><p><span>I use these nearly daily for light listening and for calls at work.</span></p><p><span>I initially didn't like the sound, but after some equalizer tuning, I found settings that I liked and have now been using for over 3 years.  My MDR-7506's sound better, but that's a different story.</span></p><p><span>The seal to the head is good, until you turn your head left or right, then it breaks a bit, but not too badly.</span></p><p><span>They hold a charge for a very long time. I haven't had to charge these more than 10 or 15 times in the years I have had them, seriously.</span></p><p><span>Wired. . . they suck. I don't recommend using them wired.</span></p><p><span>Connectivity, I've never had an issue, and have like the option to allow 2 simultaneous bluetooth connections. That lets me use my phone and PC, without needing to manually change connections.</span></p><p><span>I've never had an issue with the quality, and the included case protects them wonderfully. They ride in my daily commute bag along with my keyboard, again another story.</span></p><p><span>The noise canceling is really excellent. They cut mechanical noises the best though.</span></p><p><span>Bassy, and great for use on airplanes.</span></p><p><span>I've used them for videos, movies, music, and calls. Never had issues with any other than the normal slight delay from bluetooth for videos.</span></p><p><span>The feature where you can pause and start with a tap, adjust volume by sliding your finger, and covering the right earcup to allow pass through are all really useful.</span></p><p><span>Hopefully these last me for many more years and my over 3.5 years of use currently.</span></p><p><span>Whoa, I'm shocked at the price drop. I guess that is to be expected. I paid 398 for mine, and they are worth every penny.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="d2qmms-zck7sk-gfoadj-zfwgzb"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text" style="">Read more</span><span class="a-see-less-text" style="display:none">Read less</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2" style="display: none !important;"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">6 people found this helpful</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vo